{
  "expo": {
    "name": "Red de Apoyo Perinatal",
    "slug": "gabinete-perinatal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Red.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Red.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff",
      "imageSize": [
        500,
        500
      ]
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Red.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.jemoeche.gabineteperinatal"
    },
    "web": {
      "favicon": "./assets/Red.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-web-browser",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.gabinete-perinatal",
          "enableGooglePay": true
        }
      ],
      "expo-font",
      "expo-video",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "f8ca6ed0-f2ae-4da6-bf46-f376b65fd201"
      }
    }
  }
}
