{
  "expo": {
    "name": "Red de Apoyo Perinatal",
    "slug": "gabinete-perinatal",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/Red.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Red.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff",
      "imageSize": [
        300,
        300
      ]
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Red.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.jemoeche.gabineteperinatal",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "versionCode": 6
    },
    "web": {
      "favicon": "./assets/Red.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.gabinete-perinatal",
          "enableGooglePay": true
        }
      ],
      "expo-font",
      "expo-video",
      "expo-audio",
      "expo-web-browser",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "f8ca6ed0-f2ae-4da6-bf46-f376b65fd201"
      }
    }
  }
}
